{
  "expo": {
    "name": "Kissonde Gym",
    "slug": "kissonde-gym",
    "scheme": "kissonde",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FA",
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ao.kissonde.gym",
      "buildNumber": "1",
      "infoPlist": {
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "ao.kissonde.gym",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
